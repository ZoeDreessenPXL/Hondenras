<Window x:Class="Hondenras.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hondenras.Presentation"
        mc:Ignorable="d"
        Title="Breed Guesser" Height="700" Width="400" MinWidth="400" MinHeight="700"
        FontFamily="Comic Sans MS" Loaded="Window_Loaded">
    <Border Background="#FFF0F4F8" CornerRadius="20" Padding="20" Margin="20"
                BorderBrush="#FFDDEAF3" BorderThickness="2" >
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" >

            <TextBlock Text="Welk ras is dat?!"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FF6B5B95"
                           Margin="0 0 0 20" />

            <TextBlock Text="Raad het ras"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF8C7B7B"
                           Margin="0 0 0 10"/>

            <Border CornerRadius="15" Background="#FFF8F8F8" Padding="5" Margin="0 0 0 10" >
                <Image x:Name="dogImage"
                           Width="300"
                           Height="300"
                           Stretch="Uniform"/>
            </Border>

            <ComboBox x:Name="breedComboBox"
                          Width="220"
                          Padding="5"
                          Margin="0 0 0 10"
                          Background="#FFFDEBCF"
                          BorderBrush="#FFE2D5B7"
                          BorderThickness="1"
                          FontWeight="SemiBold"/>

            <Button Content="Raad"
                        Click="GuessButton_Click"
                        Width="220"
                        Padding="8"
                        Margin="0 0 0 10"
                        Background="#FFBFD8B8"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>

            <TextBlock x:Name="feedbackTextBlock"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FF6B5B95"
                           Margin="0 0 0 10"
                           TextAlignment="Center"/>

            <Button Content="Volgende hond"
                        Click="NextButton_Click"
                        Width="220"
                        Padding="8"
                        Background="#FF93C6E0"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>